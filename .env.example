# OpenAI-compatible Chat Completions API settings
# Local Ollama example (no real LLM API key required):
API_BASE_URL=http://127.0.0.1:11434/v1
API_KEY=ollama
API_MODEL=qwen2.5:3b
API_TIMEOUT_SECONDS=120

# Bot server port; keep in sync with the tunnel forwarding port.
BOT_PORT=3978

# Teams bot credentials. Required for authenticated/public Teams deployment.
# Obtain these from your registered bot/app configuration; never commit real values.
CLIENT_ID=
CLIENT_SECRET=
TENANT_ID=

# LOCAL Agents Playground ONLY: uncomment this for an unauthenticated local emulator.
# Do not enable this when using a public tunnel or deploying to Teams.
# DANGEROUSLY_ALLOW_UNAUTHENTICATED_REQUESTS=true

# Hosted OpenAI-compatible provider example:
# API_BASE_URL=https://api.openai.com/v1
# API_KEY=replace_with_your_provider_key
# API_MODEL=gpt-4o-mini

SYSTEM_PROMPT=You are NX Matrix AI, a professional business assistant. Give clear, accurate, concise and useful answers. If uncertain, say so. Never claim to have performed actions you have not performed.
